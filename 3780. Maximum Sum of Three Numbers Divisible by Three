class Solution {
public:
    int maximumSum(vector<int>& nums) {
        vector<int>rem0,rem1,rem2;
        for(int num:nums){
            if(num%3==0){
                rem0.push_back(num);
            }else if(num%3==1){
                rem1.push_back(num);
            }else{
                rem2.push_back(num);
            }
        }
        int max_sum=0;
        sort(rem0.rbegin(),rem0.rend());
        sort(rem1.rbegin(),rem1.rend());
        sort(rem2.rbegin(),rem2.rend());
        if(rem0.size()>=3){
            max_sum=max(max_sum,rem0[0]+rem0[1]+rem0[2]);
        }
        if(rem1.size()>=3){
            max_sum=max(max_sum,rem1[0]+rem1[1]+rem1[2]);
        }
        if(rem2.size()>=3){
            max_sum=max(max_sum,rem2[0]+rem2[1]+rem2[2]);
        }
        if(!rem0.empty() && !rem1.empty() && !rem2.empty()){
            max_sum=max(max_sum,rem0[0]+rem1[0]+rem2[0]);
        }
        return max_sum;
    }
};
