#include<iostream>
#include<bits/stdc++.h>
using namespace std;
int main(){
	int n=10e6+1;
    int l=9,r=1000;
	vector<int>primes(n,true);
	primes[0]=primes[1]=false;
	for(int i=2;i*i<n;i++){
		if(!primes[i]){
			continue;
		}
		for(int j=i*i;j<n;j+=i){
			primes[j]=false;
		}
	}
    vector<int>pre(n);
    pre[0]=primes[0];
    for(int i=1;i<n;i++){
        pre[i]=pre[i-1]+primes[i];
    }
    cout<<(pre[r]-pre[l-1]);
}
