class Solution {
public:
    int subarraysDivByK(vector<int>& nums, int k) {
        int prefix=0,count=0;
        unordered_map<int,int>m;
        m[0]=1;
        for(int i=0;i<nums.size();i++){
            prefix+=(nums[i]%k+k);
            int ele=(prefix)%k;
            count+=m[ele];
            m[ele]++;
        }
        return count;
    }
};
// this question have some trick if the remenber my be the negetive so safly add the k so the when we do the %k it will be converted into the positive remenber.
