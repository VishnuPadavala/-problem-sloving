class Solution {
public:
    int numberOfSubarrays(vector<int>& nums, int k) {
        int n=nums.size();
        unordered_map<int,int>m;
        m[0]=1;
        int count=0,prefix=0;
        for(int i=0;i<n;i++){
            if(nums[i]%2!=0){
                prefix++;
            }
            if(m.count(prefix-k)){
                count+=m[prefix-k];
            }
            m[prefix]++;
        }
        return count;
    }
};
